{
  "name": "orderflow-api",
  "version": "1.0.0",
  "private": true,
  "description": "An order management API with transactional checkout and inventory updates",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'tests/integration/**'",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "check": "node --check scripts/migrate.mjs && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "express": "^5.3.0",
    "helmet": "^8.0.0",
    "jose": "^6.0.0",
    "mysql2": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0"
  }
}
